# Atlas connection string. Set the same value in the Render service environment.
# Database name in the URI is optional; the app uses the carebaseone database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# 32자 이상. 로그인 쿠키 서명에 사용합니다.
SESSION_SECRET=

# 비어 있는 계정만 최초 1회 생성합니다. 이미 있으면 비밀번호를 바꾸지 않습니다.
SEED_SUPERVISOR_USERNAME=
SEED_SUPERVISOR_PASSWORD=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
