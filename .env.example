# Atlas connection string. Set the same value in the Render service environment.
# Database name in the URI is optional; the app uses the carebaseone database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# 32자 이상. 로그인 쿠키 서명에 사용합니다.
SESSION_SECRET=

# 비어 있는 계정만 최초 1회 생성합니다. 이미 있으면 비밀번호를 바꾸지 않습니다.
SEED_SUPERVISOR_USERNAME=
SEED_SUPERVISOR_PASSWORD=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# 회원 OAuth (선택)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 알림 (선택) — 솔라피·카카오 알림톡·SMTP
SOLAPI_API_KEY=
KAKAO_ALIMTALK_KEY=
SMTP_URL=

# 로컬 PDF 가져오기: CAREBASE_MEDIA_SOURCE 경로 후 node scripts/import-carebase-media.cjs
