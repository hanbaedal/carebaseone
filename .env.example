# Atlas connection string. Set the same value in the Render service environment.
# Database name in the URI is optional; the app uses the carebaseone database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# 32자 이상. 로그인 쿠키 서명에 사용합니다.
SESSION_SECRET=

# 관리 로그인 시드 — Render에 저장 후 재배포하면 build 단계에서 Mongo와 동기화됩니다.
# /admin/login 방문 시에도 SEED 비밀번호로 맞춥니다. 여기 적은 값과 다르면 로그인되지 않습니다.
SEED_SUPERVISOR_USERNAME=
SEED_SUPERVISOR_PASSWORD=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# 회원 OAuth (선택)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 알림 (선택) — 솔라피·카카오 알림톡·SMTP
SOLAPI_API_KEY=
KAKAO_ALIMTALK_KEY=
SMTP_URL=

# 로컬 자료 원본 폴더 (ingest·GridFS 적재용)
CAREBASE_MEDIA_SOURCE=

# public/media 복사(선택) 후 Mongo 적재: node scripts/ingest-media-to-mongo.cjs
